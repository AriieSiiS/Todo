# Liberar el compositor antes de destruir el motor evita el fallo nativo al
# salir. La copia corregida vive en build; la caché compartida de Pub no se toca.
set(webview_target flutter_inappwebview_windows_plugin)
if(TARGET ${webview_target})
  get_target_property(webview_source_dir ${webview_target} SOURCE_DIR)
  set(webview_manager "${webview_source_dir}/in_app_webview/in_app_webview_manager.cpp")
  file(READ "${webview_manager}" webview_source)
  string(FIND "${webview_source}" "    windowWebViews.clear();" shutdown_position)
  if(shutdown_position EQUAL -1)
    message(FATAL_ERROR "Ha cambiado el cierre del WebView. Revisar webview_shutdown.cmake.")
  endif()
  string(REPLACE "    windowWebViews.clear();"
    "    windowWebViews.clear();\n    compositor_ = nullptr;\n    graphics_context_.reset();\n    dispatcher_queue_controller_ = nullptr;\n    rohelper_.reset();\n    valid_ = false;"
    webview_source "${webview_source}")
  set(webview_copy "${CMAKE_BINARY_DIR}/todo_webview/in_app_webview_manager.cpp")
  file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/todo_webview")
  file(WRITE "${webview_copy}" "${webview_source}")
  get_target_property(webview_sources ${webview_target} SOURCES)
  set(webview_patched_sources "")
  foreach(source IN LISTS webview_sources)
    if(source STREQUAL "in_app_webview/in_app_webview_manager.cpp" OR source STREQUAL webview_manager)
      list(APPEND webview_patched_sources "${webview_copy}")
    elseif(IS_ABSOLUTE "${source}")
      list(APPEND webview_patched_sources "${source}")
    else()
      list(APPEND webview_patched_sources "${webview_source_dir}/${source}")
    endif()
  endforeach()
  set_property(TARGET ${webview_target} PROPERTY SOURCES "${webview_patched_sources}")
  target_include_directories(${webview_target} PRIVATE "${webview_source_dir}/in_app_webview")
endif()
